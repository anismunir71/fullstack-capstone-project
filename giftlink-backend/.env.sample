# Copy this file to `.env` and fill in real values.
# NEVER commit the actual .env file to GitHub.

# MongoDB connection string
MONGODB_URI="localhost:27017"

# Database name
DB_NAME="giftlink"

# Port for the main Express server
PORT=5000

# JWT secret (Module 4)
JWT_SECRET="replace-with-a-long-random-string"

# Optional: URL for the external sentiment service
SENTIMENT_API_URL="https://sentiment-analyzer-service.example.com/sentiment"

# Port for the sentiment microservice
SENTIMENT_PORT=6000